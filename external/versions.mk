EXTERNAL_DIR ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
EXTERNAL_DOWNLOADS := $(EXTERNAL_DIR)/downloads
EXTERNAL_SOURCES := $(EXTERNAL_DIR)/src
EXTERNAL_TOOLCHAINS := $(EXTERNAL_DIR)/toolchains
EXTERNAL_BUILD := $(EXTERNAL_DIR)/build

LINUX_VERSION := 6.12
LINUX_ARCHIVE := $(EXTERNAL_DOWNLOADS)/linux-$(LINUX_VERSION).tar.xz
LINUX_URL := https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-$(LINUX_VERSION).tar.xz
LINUX_SHA256 := b1a2562be56e42afb3f8489d4c2a7ac472ac23098f1ef1c1e40da601f54625eb
LINUX_SRC := $(EXTERNAL_SOURCES)/linux-$(LINUX_VERSION)

BUSYBOX_VERSION := 1.37.0
BUSYBOX_ARCHIVE := $(EXTERNAL_DOWNLOADS)/busybox-$(BUSYBOX_VERSION).tar.bz2
BUSYBOX_URL := https://busybox.net/downloads/busybox-$(BUSYBOX_VERSION).tar.bz2
BUSYBOX_SHA256 := 3311dff32e746499f4df0d5df04d7eb396382d7e108bb9250e7b519b837043a4
BUSYBOX_SRC := $(EXTERNAL_SOURCES)/busybox-$(BUSYBOX_VERSION)

GO_VERSION := 1.26.0
GO_ARCHIVE := $(EXTERNAL_DOWNLOADS)/go$(GO_VERSION).linux-amd64.tar.gz
GO_URL := https://go.dev/dl/go$(GO_VERSION).linux-amd64.tar.gz
GO_SHA256 := aac1b08a0fb0c4e0a7c1555beb7b59180b05dfc5a3d62e40e9de90cd42f88235
GO_ROOT := $(EXTERNAL_TOOLCHAINS)/go
GO := $(GO_ROOT)/bin/go

KUBERNETES_VERSION := v1.37.0
KUBERNETES_ARCHIVE := $(EXTERNAL_DOWNLOADS)/kubernetes-$(KUBERNETES_VERSION)-src.tar.gz
KUBERNETES_URL := https://dl.k8s.io/$(KUBERNETES_VERSION)/kubernetes-src.tar.gz
KUBERNETES_SHA256 := 054e46db628c510a9d0d78cf755720f3b325a1176dd7d18fe97776f9053f006a
KUBERNETES_SRC := $(EXTERNAL_SOURCES)/kubernetes-$(KUBERNETES_VERSION)

KUBELET := $(EXTERNAL_BUILD)/kubelet
CRI_STUB := $(EXTERNAL_BUILD)/cri-stub
